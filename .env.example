# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Get a key at https://aistudio.google.com/apikey - it is only ever passed to the `ai` container.
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Set to 1 to force evidence-only mode (no Gemini calls, no quota use), e.g. for deterministic test runs
AI_MODEL_DISABLED=
AI_TIMEOUT_S=20
AI_RATE_LIMIT_PER_HOUR=60
# Backend (defaults are fine for local demo; change JWT_SECRET for anything shared)
JWT_SECRET=dev-only-change-me
# Neo4j graph store (local dev password; only applied when the neo4j_data volume is first created)
NEO4J_PASSWORD=shodh-graph-dev
# How often the AI service re-projects PostgreSQL changes into the graph (seconds)
GRAPH_SYNC_INTERVAL_S=20
# A periodic FULL pass also prunes graph elements deleted in PostgreSQL (seconds; 0 = never), and the per-query timeout
GRAPH_FULL_REBUILD_INTERVAL_S=600
GRAPH_QUERY_TIMEOUT_S=6
# Agent tool-selection: `policy` (deterministic, default) or `llm` (Gemini chooses the next tool; costs extra model calls)
AI_AGENT_PLANNER=policy
AI_AGENT_MAX_STEPS=4
AI_AGENT_ENABLED=1
AI_AGENT_TOOL_TIMEOUT_S=8
