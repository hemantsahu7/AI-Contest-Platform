# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Get a key at https://aistudio.google.com/apikey - it is only ever passed to the `ai` container.
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Set to 1 to force evidence-only mode (no Gemini calls, no quota use), e.g. for deterministic test runs
AI_MODEL_DISABLED=
AI_TIMEOUT_S=20
AI_RATE_LIMIT_PER_HOUR=60
# Backend (defaults are fine for local demo; change JWT_SECRET for anything shared)
JWT_SECRET=dev-only-change-me
