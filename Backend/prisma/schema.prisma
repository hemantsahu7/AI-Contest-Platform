generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  INSTRUCTOR
  LEARNER
}

enum ContestStatus {
  DRAFT
  UPCOMING
  RUNNING
  ENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  INFRASTRUCTURE_ERROR
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  JUDGE_ERROR
}

enum JudgeExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum IncidentType {
  CONTAINER_START_FAILURE
  TIMEOUT
  DOCKER_ERROR
  WORKER_FAILURE
  UNKNOWN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         GlobalRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    OrganizationMembership[]
  participations ContestParticipant[]
  submissions    Submission[]

  @@index([email])
  @@index([username])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  contests    Contest[]
}

model OrganizationMembership {
  id             String     @id @default(uuid())
  userId         String
  organizationId String
  role           GlobalRole
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Contest {
  id             String        @id @default(uuid())
  title          String
  description    String
  organizationId String
  startTime      DateTime
  endTime        DateTime
  status         ContestStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants ContestParticipant[]
  problems     Problem[]
  submissions  Submission[]

  @@index([organizationId])
  @@index([startTime, endTime])
}

model ContestParticipant {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  joinedAt  DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([userId])
}

model Problem {
  id            String     @id @default(uuid())
  contestId     String
  title         String
  description   String
  difficulty    Difficulty
  points        Int
  timeLimitMs   Int
  memoryLimitMb Int
  inputFormat   String
  outputFormat  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contest     Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  submissions Submission[]

  @@index([contestId])
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean  @default(true)
  createdAt      DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Submission {
  id          String           @id @default(uuid())
  contestId   String
  problemId   String
  userId      String
  sourceCode  String
  language    String
  status      SubmissionStatus @default(QUEUED)
  verdict     Verdict          @default(PENDING)
  score       Int              @default(0)
  submittedAt DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  contest    Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem    Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions JudgeExecution[]
  incidents  JudgeIncident[]

  @@index([contestId, userId])
  @@index([problemId])
  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model JudgeVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  description String
  createdAt   DateTime @default(now())

  executions JudgeExecution[]
}

model JudgeExecution {
  id              String                @id @default(uuid())
  submissionId    String
  judgeVersionId  String
  startedAt       DateTime
  finishedAt      DateTime?
  status          JudgeExecutionStatus
  verdict         Verdict               @default(PENDING)
  executionTimeMs Int?
  memoryUsedMb    Int?
  testsPassed     Int?
  testsTotal      Int?
  stdout          String?
  stderr          String?
  errorMessage    String?
  createdAt       DateTime              @default(now())

  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeVersion JudgeVersion    @relation(fields: [judgeVersionId], references: [id])
  incidents    JudgeIncident[]

  @@index([submissionId])
}

model JudgeIncident {
  id               String       @id @default(uuid())
  submissionId     String
  judgeExecutionId String?
  type             IncidentType
  message          String
  createdAt        DateTime     @default(now())
  resolvedAt       DateTime?

  submission     Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeExecution JudgeExecution? @relation(fields: [judgeExecutionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}
